# === Database ===
# Contoh lokal:  postgresql://postgres:postgres@localhost:5432/dojoku
# Contoh Neon:   postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/dojoku?sslmode=require
DATABASE_URL=""

# Koneksi DIRECT Neon (tanpa -pooler, dipakai untuk migrasi/db push).
# Contoh: postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/dojoku?sslmode=require
DIRECT_URL=""

# === NextAuth v5 ===
# Generate dengan: openssl rand -base64 32
NEXTAUTH_SECRET=""
# URL aplikasi, mis. http://localhost:3000 (tanpa trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# === Cron tagihan bulanan (§67) ===
# Rahasia untuk endpoint POST /api/cron/tagihan (dipanggil scheduler eksternal).
# Generate dengan: openssl rand -base64 32
CRON_SECRET="isi-dengan-nilai-acak-panjang"

# === Penyimpanan file via Telegram (bukti transfer & selfie absensi) ===
# Bot Telegram untuk menyimpan file secara permanen & gratis.
# Bila dikosongkan, aplikasi fallback ke penyimpanan lokal (badge "Sementara").
# Token dipakai sekali via env (Vercel), TIDAK PERNAH disimpan di repo.
# Cara mendapatkan (lihat DEPLOY.md Langkah 9):
#   1. Chat @BotFather di Telegram → /newbot → salin token
#   2. Buat channel/group pribadi → tambahkan bot sebagai admin
#   3. Kirim pesan di channel/group → dapatkan chat ID via getUpdates
TELEGRAM_BOT_TOKEN=""
TELEGRAM_STORAGE_CHAT_ID=""
